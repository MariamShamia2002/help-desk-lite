# The app always calls the API through the Vite proxy (same-site, so the refresh cookie works).
VITE_API_URL=/api

# Where the dev server forwards /api: a local or staging backend, never production.
API_PROXY_TARGET=http://localhost:4100

# API-side only (not a Vite env): run the backend with DEBUG_TOOLS=true so /_debug/*
# and X-Debug-* headers work. The frontend Debug Tools drawer mounts only in Vite DEV.
